{
  "id": "com.cuarentaysiete.eight-ras.tracker",
  "name": "8RAS Time Tracker",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0"
  },
  "permissions": {
    "localFileSystem": "full"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "main-panel",
      "label": {"default": "8RAS"},
      "path": "./index.html",
      "minimumSize": {"width": 280, "height": 400},
      "preferredDockedSize": {"width": 320, "height": 500}
    }
  ],
  "icons": [
    {"path": "public/icon.png", "size": 64}
  ]
}
