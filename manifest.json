{
  "$schema": "https://json.schemastore.org/uxp-webview-plugin-manifest.schema.json",
  "id": "com.cuarentaysiete.eight-ras.tracker",
  "name": "8RAS Time Tracker",
  "version": "1.0.0",
  "main": "index.html",
  "uiHost": {
    "path": "index.html",
    "width": 320,
    "height": 500,
    "minimumWidth": 280,
    "minimumHeight": 400
  },
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "permissions": {
    "localFileSystem": "full"
  },
  "icons": [
    {"src": "public/icon.png", "width": 64, "height": 64}
  ]
}
