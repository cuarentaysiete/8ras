{
  "$schema": "https://json.schemastore.org/uxp-plugin-manifest.schema.json",
  "id": "com.cuarentaysiete.eight-ras.tracker",
  "name": "8RAS Time Tracker",
  "version": "1.0.0",
  "main": "bundle.js",
  "host": {
    "app": "PS",
    "minVersion": "28.0.0"
  },
  "permissions": {
    "localFileSystem": "full"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "main-panel",
      "label": {"default": "8RAS"},
      "path": "./index.html"
    }
  ],
  "unhandledRejection": "suppress"
}
